<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_height"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adicionar Peça"
        android:textColor="#00FF66"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/edtNomePeca"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@android:drawable/edit_text"
        android:hint="Nome da Peça (ex: RTX 4070)"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="15dp"
        android:inputType="text"/>

    <EditText
        android:id="@+id/edtCategoriaPeca"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@android:drawable/edit_text"
        android:hint="Categoria (ex: Placa de Vídeo)"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="15dp"
        android:inputType="text"/>

    <EditText
        android:id="@+id/edtPrecoPeca"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@android:drawable/edit_text"
        android:hint="Preço (R$)"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="30dp"
        android:inputType="numberDecimal"/>

    <Button
        android:id="@+id/btnSalvarPeca"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#00FF66"
        android:text="SALVAR COMPONENTE"
        android:textColor="#121212"
        android:textSize="16sp"
        android:textStyle="bold"/>

</LinearLayout>