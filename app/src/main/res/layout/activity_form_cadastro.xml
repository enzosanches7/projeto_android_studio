<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    tools:context=".FormCadastro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Criar Conta"
            android:textColor="#00E676"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/edtNomeCadastro"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nome Completo"
            android:textColorHint="#7C7C8A"
            android:textColor="#FFFFFF"
            android:inputType="textPersonName"
            android:background="#202024"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtEmailCadastro"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="E-mail"
            android:textColorHint="#7C7C8A"
            android:textColor="#FFFFFF"
            android:inputType="textEmailAddress"
            android:background="#202024"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtSenhaCadastro"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Senha (mínimo 6 caracteres)"
            android:textColorHint="#7C7C8A"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:background="#202024"
            android:padding="16dp"
            android:layout_marginBottom="24dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCadastrar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Cadastrar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#00E676" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>