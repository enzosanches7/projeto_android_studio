<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050707">

    <ImageView
        android:id="@+id/img_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/img_placa_mae"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/view_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_degrade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp"
        android:layout_centerInParent="true">

        <TextView
            android:id="@+id/txtLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETUPCRAFT"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#00FF66"
            android:letterSpacing="0.1"
            android:layout_marginBottom="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_login"
            android:padding="24dp"
            android:layout_marginHorizontal="16dp">

            <EditText
                android:id="@+id/edit_email"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/shape_input_field"
                android:hint="Email ou Usuário"
                android:textColorHint="#556565"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:inputType="textEmailAddress"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/edit_senha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/shape_input_field"
                android:hint="Senha"
                android:textColorHint="#556565"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:inputType="textPassword"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Esqueceu sua senha?"
                android:textColor="#CFA146"
                android:textSize="12sp"
                android:layout_gravity="end"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_entrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#00FF66"
                android:text="LOG IN"
                android:textColor="#050707"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Não tem uma conta? "
                    android:textColor="#8A9A9A"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txt_ir_cadastro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CRIAR CONTA"
                    android:textColor="#CFA146"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>